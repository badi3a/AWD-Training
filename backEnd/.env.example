# ============================================================================
# JobBoard REST API — Fichier d'exemple de configuration
# ----------------------------------------------------------------------------
# Copiez ce fichier en `.env` puis renseignez vos valeurs locales :
#   cp .env.example .env
# ============================================================================

# ---------- Serveur HTTP ----------
PORT=3000
NODE_ENV=development

# Origines autorisées par CORS (séparées par une virgule, sans espace).
# Astuce : mettez '*' en dev si vous ne savez pas.
CORS_ORIGIN=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5500

# ---------- Base de données MySQL ----------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=jobboard
DB_USER=root
DB_PASSWORD=

# Nombre max de connexions simultanées dans le pool MySQL.
DB_POOL_LIMIT=10

# ---------- Journalisation ----------
# Format Morgan : dev | combined | short | tiny
LOG_FORMAT=dev
