<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>{% block title %}JobBoard{% endblock %}</title><link rel="stylesheet" href="{{ asset('css/app.css') }}"></head><body><header><a class="brand" href="{{ path('app_home') }}">JobBoard</a><nav><a href="{{ path('app_home') }}">Jobs</a>{% if app.user %}<a href="{{ path('app_logout') }}">Logout</a>{% else %}<a href="{{ path('app_login') }}">Login</a>{% endif %}</nav></header>{% for type,messages in app.flashes %}{% for message in messages %}<div class="flash {{ type }}">{{ message }}</div>{% endfor %}{% endfor %}<main>{% block body %}{% endblock %}</main><footer>ESPRIT · Distributed Web Applications · Teaching monolith</footer></body></html>