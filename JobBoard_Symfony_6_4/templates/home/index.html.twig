{% extends 'base.html.twig' %}{% block title %}Jobs · JobBoard{% endblock %}{% block body %}<section class="hero"><h1>Find your next opportunity</h1><form><input name="q" value="{{ q }}" placeholder="Search jobs"><button>Search</button></form></section><section class="cards">{% for job in jobs %}<article><h2><a href="{{ path('app_job_show',{id:job.id}) }}">{{ job.title }}</a></h2><p>{{ job.company.name }} · {{ job.location ?: 'Location flexible' }}</p><span>{{ job.contractType }}</span>{% if job.remote %}<span>Remote</span>{% endif %}</article>{% else %}<p>No published jobs found.</p>{% endfor %}</section>{% endblock %}