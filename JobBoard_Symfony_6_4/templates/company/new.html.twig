{% extends 'base.html.twig' %}{% block body %}<form class="panel" method="post"><h1>Create a job</h1><label>Title<input name="title" required></label><label>Description<textarea name="description" rows="8" required></textarea></label><label>Contract<select name="contractType"><option>CDI</option><option>CDD</option><option>INTERNSHIP</option><option>FREELANCE</option></select></label><label>Location<input name="location"></label><label><input type="checkbox" name="remote" value="1"> Remote</label><label><input type="checkbox" name="published" value="1"> Publish now</label><input type="hidden" name="_token" value="{{ csrf_token('new-job') }}"><button>Create</button></form>{% endblock %}