{% extends 'base.html.twig' %}{% block body %}<h1>Company jobs</h1><a class="button" href="{{ path('company_job_new') }}">Create a job</a><section class="cards">{% for job in jobs %}<article><h2>{{ job.title }}</h2><p>{{ job.contractType }} · {{ job.published ? 'Published' : 'Draft' }}</p><b>{{ job.applications|length }} application(s)</b></article>{% endfor %}</section>{% endblock %}